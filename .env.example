# OPNsense backup configuration. Copy to .env and edit.
# This file is sourced by bash: quote values, and avoid $(...) in them.

# Git working copy that holds config_<name>.xml files (must already be a git repo)
BACKUP_DIR="/home/you/Documents/opnsense_backups"

# Firewall list (see opnsense_list.txt.example)
OPNSENSE_LIST="/home/you/Documents/opnsense_backups/opnsense_list.txt"

# Directory holding one API key file per firewall: <name>.txt, mode 600,
# in the format OPNsense downloads (key=... / secret=...). Keep it outside git.
API_KEY_DIR="/home/you/.config/opnsense-backup/keys"

# Log file
LOG_FILE="/home/you/Documents/opnsense_backup.log"

# Optional: alert de-duplication state and run lock
#STATE_DIR="/home/you/.local/state/opnsense-backup"

# Optional: refuse a download smaller than this % of the previous copy
#MIN_SIZE_PERCENT="50"

# Optional: curl timeouts in seconds
#CURL_CONNECT_TIMEOUT="15"
#CURL_MAX_TIME="120"

# Git
GIT_PUSH="true"
#GIT_COMMIT_PREFIX="Automated OPNsense configuration backup"

# Notifications
# Teams: legacy connector URLs (*.webhook.office.com) and Teams Workflows URLs both work.
TEAMS_WEBHOOK_ENABLED="false"
TEAMS_WEBHOOK_URL=""
DISCORD_WEBHOOK_ENABLED="false"
DISCORD_WEBHOOK_URL=""

# "true": alert only on failures (and once on recovery). "false": also a summary on every success.
WEBHOOK_NOTIFY_ERRORS_ONLY="true"
# While something keeps failing, repeat the alert at most every N hours
WEBHOOK_REPEAT_HOURS="24"
